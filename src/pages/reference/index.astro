---
import ReferenceLayout from '../../layouts/ReferenceLayout.astro';
import { getCollection, render } from 'astro:content';

// Récupère et trie les posts
const sortedPosts = (await getCollection('reference')).sort(
  (a, b) => (a.data.order ?? 0) - (b.data.order ?? 0)
);

const contents = await Promise.all(
  sortedPosts.map(async (post) => {
    
    
    
    const { Content } = await render(post);
    return { ...post, Content };
  })
);

const navItems = contents.map((el) => ({
  title: el.data.title,
  id: el.id,
}));

---

<ReferenceLayout nav={navItems}>
  <h1>API Reference</h1>

  <section>
  {contents.map((post) => (
    <article id={post.id}>
      <h2 class="title">{post.data.title}</h2>
      <post.Content />
      {/*<div class="background-wrapper"></div>*/}
    </article>
  ))}
  </section>

  </div>

  <style>
    article {
      display:grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
      padding-right: 1rem;
    }

    article :global(*){
      grid-column: 1/2;
    }

    section{
      /*background-color: var(--background-emphasis);*/
    }

    article :global(.astro-code) {
      grid-column: 2/3;
      height: fit-content;
      position: sticky;
      top: 1rem;
    }
    
  </style>
  
</ReferenceLayout>