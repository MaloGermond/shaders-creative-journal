---
import ReferenceLayout from '../../layouts/ReferenceLayout.astro';
import { getCollection, render } from 'astro:content';

// Récupère et trie les posts
const sortedPosts = (await getCollection('reference')).sort(
  (a, b) => (a.data.order ?? 0) - (b.data.order ?? 0)
);

const contents = await Promise.all(
  sortedPosts.map(async (post) => {
    const { Content } = await render(post);
    return { ...post, Content };
  })
);

const navItems = contents.map((el) => ({
  title: el.data.title,
  id: el.id,
}));

---

<ReferenceLayout nav={navItems}>
  <h1>API Reference</h1>

  {contents.map((post) => (
    <section id={post.id}>
      <div class="wrapper">
        <h2 class="title">{post.data.title}</h2>
        <post.Content />
      </div>
    </section>
  ))}

  </div>

  <style>
    .wrapper{
      display:grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }

    .wrapper :global(*) {
      grid-column: 2 / 3;
    }

    .wrapper :global(:not(.astro-code)) {
      grid-column: 1 / 2;
    }

    .wrapper::after {
      content: "";
      grid-column: 2 / 3;
      background-color: #f0f0f0;
      z-index: -1;
    }

  </style>
  
</ReferenceLayout>