---
import '../styles/codemirror.css';

const { doc = `function hello() {
  // Et les commentaires alors ?
  console.log("hello les loulous");
  var Library = require('sketch/dom').Library
  document.changeColorSpace(ColorSpace.P3, true)
}` } = Astro.props;

---

<section>
  <div id="editor" data-doc={JSON.stringify(doc)}></div>
</section>

<client:only>
  <script>
    // Ne pas oublier d'activer/desactivé les lib dans vite.config.js
    import { EditorView, keymap, highlightSpecialChars, drawSelection, dropCursor } from "@codemirror/view";
    import { syntaxHighlighting, defaultHighlightStyle, bracketMatching, HighlightStyle } from "@codemirror/language";
    import { javascript } from "@codemirror/lang-javascript";
    import { indentWithTab } from "@codemirror/commands";
    import { autocompletion } from "@codemirror/autocomplete";
    import { tags } from "@lezer/highlight";
    

    const editorElement = document.querySelector("#editor");
    const doc = JSON.parse(editorElement.dataset.doc);

    const customHighlighting = HighlightStyle.define([
  // Styles par défaut (optionnel)
  { tag: tags.keyword, color: "#D08E00" },
  { tag: tags.string, color: "#FA3B44" },
  { tag: tags.number, color: "#164" },
  { tag: tags.lineComment, color: "#949495" },
  { tag: tags.function(tags.variableName), color: "#6F3BFF" },
   { tag: tags.variableName, color: "#DE6DF1", fontWeight: "bold" },
]);


    const customBasicSetup = [
      highlightSpecialChars(),
      drawSelection(),
      dropCursor(),
      bracketMatching(),
      autocompletion(),
      syntaxHighlighting(customHighlighting),
    ];

    new EditorView({
      doc: doc,
      parent: document.querySelector("#editor"),
      extensions: [customBasicSetup,
        javascript(),
        keymap.of([indentWithTab]),
      ]
    });

  </script>
</client:only>

